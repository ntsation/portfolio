{
  "name": "ntsation",
  "private": true,
  "version": "1.6.1",
  "type": "module",
  "scripts": {
    "fetch": "node scripts/fetch-readmes.mjs",
    "predev": "node scripts/fetch-readmes.mjs --if-missing",
    "dev": "vite",
    "prebuild": "node scripts/fetch-readmes.mjs",
    "build": "tsc -b && vite build && node scripts/prerender.mjs",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "highlight.js": "^11.12.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.3",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.80.0",
    "typescript": "~7.0.2",
    "vite": "^8.2.0"
  }
